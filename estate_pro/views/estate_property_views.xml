<?xml version="1.0"?>
<odoo>
    <!-- Action for estate property -->
    <record id="estate_property_view" model="ir.actions.act_window">
        <field name="name">Estate property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <!-- Tree view -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="PRO">
                <field name="name" string="ohoo"/>
                <field name="last_seen"/>
                <field name="status"/>
                <field name="property_type" string="Property Type"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate PRO">
                <header>
                    <button name="cancel_property" type="object" string="Cancel" invisible="stats == 'canceled' or stats == 'sold'"/>
                    <button name="sold_property" type="object" string="Sold" invisible="stats == 'canceled'  or stats == 'sold'"/>
                    <field name="stats" widget="statusbar"/>
                </header>
                <sheet>
                   <group>
                        <h1>
                            <field name="name" class="mb16"/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="last_seen" string="date"/>
                            <field name="tag" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="garden_orientation"/>
                            <field name="living_area"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                            <field name="status" string="status"/>
                            <field name="property_type" string="Property Type" options="{'no_create': True, 'no_edit': True}"/>
                            </group>
                        </page>

                        <page string="Other Info">
                            <group>
                            <field name="buyer"/>
                            <field name="sales_man"/>
                            <field name="living_area"/>
                            <field name="garden"/>
                            <field name="garden_area" invisible="garden == False"/>
                            <field name="total_area" invisible="garden == False"/>
                            <field name="date_availability"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <group>
                            <field name="offer"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view Error: The root node of a form view should be a <form>, not a <search>-->

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Tests">
                <group>
                <field name="name"/>
                <field name="last_seen"/>
                 <field name="status" string="status"/>
                 <field name="property_type" string="Property Type"/>

                <filter string="Archived" name="inactive" domain="[('status', '=', False)]"/>
                <filter name="garden" string="Garden" domain="[('garden','=',True)]" help="Show only Garden"/>
                <field name="living_area" string="Living AREA" filter_domain="[('name', '>=', self)]" />
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type" records_draggable="0">
                <field name="stats"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div>
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div>
                                Expected Price: <field name="expected_price"/>
                            </div>
                            <div t-if="record.stats.raw_value == 'offer_received'">
                                Best Offer: <field name="best_price"/>
                            </div>
                            <div t-if="record.selling_price.raw_value">
                                Selling Price: <field name="selling_price"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>